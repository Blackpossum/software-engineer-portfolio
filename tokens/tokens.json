{
  "color": {
    "bg/base": "#000000",
    "bg/surface": "#0A0A0A",
    "bg/raised": "#1A1A1A",
    "border": "#2E2E2E",
    "accent": "#CCFF33",
    "info": "#38BDF8",
    "success": "#22C55E",
    "error": "#F87171",
    "text/primary": "#EDEDED",
    "text/secondary": "#D4D4D4",
    "text/muted": "#A1A1A1",
    "accent/hover": "#D4FF66"
  },
  "font": {
    "font/sans": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif",
    "font/mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "motion": {
    "ease": "cubic-bezier(.16,1,.3,1)",
    "gsapEases": [
      "expo.out",
      "expo.inOut",
      "power3.out",
      "power4.out",
      "back.out(3)"
    ]
  },
  "breakpoints": {
    "tablet": 991,
    "mobileLandscape": 767,
    "mobile": 479
  }
}
